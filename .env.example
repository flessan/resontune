# ResonTune environment configuration
# Copy to .env — never commit real values.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string. When unset, the server runs an embedded
# PGlite Postgres under var/pglite (perfect for local development).
# DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/resontune?sslmode=require

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the API server (serves the built client in production too).
API_PORT=8787

# ─── Authentication (Neon Auth) ──────────────────────────────────────────────
# Neon Auth is the single authentication authority. Enable Auth on your Neon
# project and copy the Base URL (…/neondb/auth) here. The API verifies every
# bearer token against the JWKS endpoint — signatures, expiry, issuer.
# The frontend needs the same URL as VITE_NEON_AUTH_URL (see below).
# NEON_AUTH_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Optional override; defaults to {NEON_AUTH_URL}/.well-known/jwks.json
# NEON_AUTH_JWKS_URL=
# Optional inline JWKS JSON (pins keys; skips the network fetch). Public keys
# only — never a secret.
# NEON_AUTH_JWKS_JSON=

# Frontend (Vite) — same base URL, exposed to the client bundle:
# VITE_NEON_AUTH_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth

# ─── Roles (production authorization) ────────────────────────────────────────
# Comma-separated ResonTune user ids granted admin / moderator on the server
# side. These override the users.role column and are the way to bootstrap the
# first admin. Find a user's id in the users table or /api/auth/me.
# ADMIN_USER_IDS=
# MODERATOR_USER_IDS=

# ─── Community channels ──────────────────────────────────────────────────────
# External channels where music release/intake happens. Shown on the Release
# Music page. All optional; buttons only appear for configured links.
# COMMUNITY_DISCORD_URL=
# COMMUNITY_TELEGRAM_URL=
# COMMUNITY_WHATSAPP_URL=

# ─── Audio storage ───────────────────────────────────────────────────────────
# Base URL prepended to hosted-audio object keys when resolving playback.
# Default: /media/audio (files served by this server). Point it at your
# object-storage/CDN origin when audio moves off the app server, e.g.
# AUDIO_CDN_BASE=https://media.resontune.example/audio

# ─── Support / donations (public links only, changeable at runtime too) ─────
# GITHUB_SPONSORS_URL=
# SOCIABUZZ_URL=
# QRIS_IMAGE_URL=
# REPO_URL=https://github.com/flessan/resontune

# NODE_ENV=production requires DATABASE_URL.
