# ResonTune environment configuration
# Copy to .env — never commit real values.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string. When unset, the server runs an embedded
# PGlite Postgres under var/pglite (perfect for local development).
# DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/resontune?sslmode=require

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the API server (serves the built client in production too).
API_PORT=8787
# Public origin of the app, used to build OAuth callback URLs.
# APP_ORIGIN=https://resontune.example

# ─── Authentication (GitHub OAuth) ───────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers with callback
# URL: {APP_ORIGIN}/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# When GitHub OAuth is configured, the local dev sign-in disables itself.
# Set to "true" only in development if you need both at once.
# ALLOW_DEV_LOGIN=false

# NODE_ENV=production enables Secure cookies.
# NODE_ENV=production
