# ResonTune environment configuration
# Copy to .env - never commit real values.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string. When unset, the server runs an embedded
# PGlite Postgres under var/pglite (perfect for local development).
# DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/resontune?sslmode=require

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the API server (serves the built client in production too).
API_PORT=8787

# ─── Authentication (Neon Auth) ──────────────────────────────────────────────
# Neon Auth is the single authentication authority. Enable Auth on your Neon
# project and copy the Base URL (…/neondb/auth) here. The API verifies every
# bearer token against the JWKS endpoint - signatures, expiry, issuer.
# The frontend needs the same URL as VITE_NEON_AUTH_URL (see below).
# NEON_AUTH_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Optional override; defaults to {NEON_AUTH_URL}/.well-known/jwks.json
# NEON_AUTH_JWKS_URL=
# Optional inline JWKS JSON (pins keys; skips the network fetch). Public keys
# only - never a secret.
# NEON_AUTH_JWKS_JSON=

# Frontend (Vite) - same base URL, exposed to the client bundle:
# VITE_NEON_AUTH_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth

# ─── Identity deletion (optional, server-side) ───────────────────────────────
# When a member deletes their account, ResonTune always deletes its own data.
# Deleting the Neon Auth *identity* (email, password, sessions) additionally
# needs Neon's control-plane API:
#   DELETE {NEON_API_BASE}/projects/{id}/branches/{id}/auth/users/{auth_user_id}
# Leave these unset and nothing breaks: the browser then tries Better Auth's
# own self-service deletion, and if that is disabled the UI tells the member
# plainly that the sign-in identity still exists.
#
# Use a PROJECT-SCOPED Neon API key (org admin → API keys → scope to this
# project, or `neon api-keys create --project-id …`). A project-scoped key
# cannot touch other projects, create projects or mint further keys. It is
# still powerful inside this project - treat it like a database password.
# Server-side only; never prefix it with VITE_.
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_BRANCH_ID=br-...        # the branch Neon Auth is enabled on (usually main)
# NEON_API_BASE=https://console.neon.tech/api/v2   # override only for testing

# ─── Deletion tombstones ─────────────────────────────────────────────────────
# How long a deleted identity stays revoked in the shared deleted_identities
# table, so that a JWT minted before the deletion cannot recreate the account
# on any instance. Should comfortably exceed your Neon Auth token lifetime.
# Default 24 hours. Rows expire and are swept by the next deletion.
# IDENTITY_TOMBSTONE_HOURS=24

# ─── Roles (production authorization) ────────────────────────────────────────
# Comma-separated ResonTune user ids granted admin / moderator on the server
# side. These override the users.role column and are the way to bootstrap the
# first admin. Find a user's id in the users table or /api/auth/me.
# ADMIN_USER_IDS=
# MODERATOR_USER_IDS=

# ─── Profile photos (ImgBB) ──────────────────────────────────────────────────
# ResonTune's only image upload path: a member's profile photo travels
# browser → ResonTune server → ImgBB, and only the returned URL is stored in
# Postgres. This key is read server-side exclusively - never expose it to the
# client and never prefix it with VITE_. Without it, avatar upload is
# disabled (the API answers 503) and initials are used instead; everything
# else keeps working. Get a key at https://api.imgbb.com/
# IMGBB_API_KEY=

# Catalog audio and album artwork are NOT uploaded through ResonTune: an
# administrator pastes already-hosted https URLs in the catalog manager and
# the database stores the address only.

# ─── Community channels ──────────────────────────────────────────────────────
# External channels where music release/intake happens. Shown on the Release
# Music page. All optional; buttons only appear for configured links.
# COMMUNITY_DISCORD_URL=
# COMMUNITY_TELEGRAM_URL=
# COMMUNITY_WHATSAPP_URL=

# ─── Audio storage ───────────────────────────────────────────────────────────
# Base URL prepended to hosted-audio object keys when resolving playback.
# Default: /media/audio (files served by this server). Point it at your
# object-storage/CDN origin when audio moves off the app server, e.g.
# AUDIO_CDN_BASE=https://media.resontune.example/audio

# ─── Media URL safety ────────────────────────────────────────────────────────
# Media and link URLs must be https and must not point at private, loopback or
# internal addresses. Set this to 1 only on a development machine that needs to
# reference http://localhost media; never set it in production.
# ALLOW_LOCAL_MEDIA_URLS=0

# ─── Support / donations (public links only, changeable at runtime too) ─────
# GITHUB_SPONSORS_URL=
# SOCIABUZZ_URL=
# QRIS_IMAGE_URL=
# REPO_URL=https://github.com/flessan/resontune

# NODE_ENV=production requires DATABASE_URL.
