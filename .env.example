# ResonTune environment configuration
# Copy to .env — never commit real values.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string. When unset, the server runs an embedded
# PGlite Postgres under var/pglite (perfect for local development).
# DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/resontune?sslmode=require

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the API server (serves the built client in production too).
API_PORT=8787
# Public origin of the app, used to build OAuth callback URLs.
# APP_ORIGIN=https://resontune.example

# ─── Authentication (GitHub OAuth) ───────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers with callback
# URL: {APP_ORIGIN}/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# When GitHub OAuth is configured, the local dev sign-in disables itself.
# Set to "true" only in development if you need both at once.
# In production, dev sign-in is always off unless this is explicitly "true".
# ALLOW_DEV_LOGIN=false

# ─── Roles (production authorization) ────────────────────────────────────────
# Comma-separated user ids granted admin / moderator on the server side.
# These override the users.role column and are the ONLY way to bootstrap the
# first admin in production ("first account becomes admin" applies to local
# development only). Find a user's id in the users table or /api/auth/me.
# ADMIN_USER_IDS=
# MODERATOR_USER_IDS=

# ─── Audio storage ───────────────────────────────────────────────────────────
# Base URL prepended to hosted-audio object keys when resolving playback.
# Default: /media/audio (files served by this server). Point it at your
# object-storage/CDN origin when audio moves off the app server, e.g.
# AUDIO_CDN_BASE=https://media.resontune.example/audio

# NODE_ENV=production enables Secure cookies and requires DATABASE_URL.
# NODE_ENV=production
